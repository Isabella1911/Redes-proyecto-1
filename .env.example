# Clave de la API de Anthropic -- https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Clave gratuita de Pl@ntNet para identificar plantas por foto
# -- https://my.plantnet.org/ (500 identificaciones/dia en el plan gratuito)
PLANTNET_API_KEY=your-plantnet-key-here

# Opcional: modelo a usar. Descomentar si la API key no tiene acceso al
# modelo por defecto (claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Opcional: carpeta donde el servidor flora-mcp busca las fotos cuando se le
# pasa un nombre de archivo relativo. Por defecto ./workspace
# FLORA_IMAGES_DIR=workspace

# Opcional: servidores MCP remotos (Streamable HTTP), separados por comas.
# Cada entrada puede llevar un nombre antes del "=".
# FLORA_REMOTE_MCP=flora-remoto=http://192.168.1.50:8100/mcp
# FLORA_REMOTE_MCP=https://flora.example.com/mcp,compa=https://otro.example.com/mcp
